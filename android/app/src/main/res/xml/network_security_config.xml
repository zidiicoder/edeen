<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Allow cleartext (HTTP) traffic to the origin server IP so the mobile
         app can bypass the Hostinger CDN JS challenge. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">45.130.228.181</domain>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>
    <!-- Default config for all other domains -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
